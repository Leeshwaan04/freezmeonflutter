generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(uuid())
  email         String?     @unique
  passwordHash  String?
  fcmToken      String?
  status        String      @default("active")
  selfieKey     String?
  emailVerified Boolean     @default(false)
  lastActiveAt  DateTime?
  createdAt     DateTime    @default(now())
  profile       Profile?
  membership    Membership?
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Profile {
  id               String    @id @default(uuid())
  userId           String    @unique
  name             String
  age              Int
  bio              String?
  imageUrl         String?
  isPremium        Boolean   @default(false)
  isVerified       Boolean   @default(false)
  interests        String[]
  lat              Float?
  lng              Float?
  geohash          String?
  frozen           Boolean   @default(false)
  freezeUntil      DateTime?
  allowBlindReveal Boolean   @default(false)
  updatedAt        DateTime  @updatedAt

  // ── Calibration / onboarding signals ───────────────────────────────────────
  intent            String?    // meaningful | exploring | friendship
  personalityTraits String[]   // introvert, extrovert, adventurous, cautious, logical, emotional, spontaneous, planner
  lifestyleFactors  String[]   // fitness, travel, career, creative, spiritual
  archetype         String?    // explorer | nurturer | visionary | harmonizer | dynamo
  promptAnswer      Json?      // { prompt: string, answer: string }

  // ── Derived energy profile from forced-choice calibration ──────────────────
  energyType        String?    // deep_diver | room_igniter | quiet_storm | open_road
  paceSignal        String?    // takes_their_time | moves_with_interest | quick_connector

  // ── Presence system ─────────────────────────────────────────────────────────
  presenceWindows   Json?      // [{ day: 0-6, startHour: 9, endHour: 22 }]
  genderPrefs       String[]   // man | woman | nonbinary
  ageMin            Int        @default(18)
  ageMax            Int        @default(99)
  messagingPref     String     @default("anyone") // anyone | matches_only
  distanceKm        Float      @default(50)
  gender            String?

  presenceScore     Int        @default(50)   // 0-100, computed by cron
  presenceLabel     String     @default("in_the_flow") // in_the_fire | in_the_flow | in_the_quiet | frozen

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([geohash])
  @@index([isPremium])
  @@index([frozen])
  @@index([intent])
  @@index([energyType])
  @@index([presenceScore])
}

model Like {
  id        String   @id @default(cuid())
  senderUid String
  targetUid String
  likedAt   DateTime @default(now())

  @@unique([senderUid, targetUid])
  @@index([senderUid])
  @@index([targetUid])
}

model Skip {
  id        String   @id @default(cuid())
  senderUid String
  targetUid String
  skippedAt DateTime @default(now())

  @@unique([senderUid, targetUid])
  @@index([senderUid])
}

model Match {
  id             String   @id @default(cuid())
  members        String[]
  status         String   @default("active")
  // Sorted "uidA_uidB" key, unique while the match is active, NULL once
  // unmatched so the pair can re-match later. Enforces one active match per
  // pair and prevents the concurrent-mutual-like race (two Match rows).
  activeMatchKey String?  @unique
  createdAt      DateTime @default(now())
  chats          Chat[]

  @@index([members])
}

model Chat {
  id        String    @id @default(cuid())
  members   String[]
  matchId   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  match     Match?    @relation(fields: [matchId], references: [id])

  @@index([members])
  @@index([updatedAt])
  @@index([matchId])
}

model Message {
  id            String    @id @default(cuid())
  chatId        String
  senderUid     String
  text          String
  // Client-generated idempotency key — prevents duplicate persists on retry.
  clientMsgId   String?
  // ACK lifecycle: sending → sent → delivered → read
  status        String    @default("sent")
  deliveredAt   DateTime?
  readAt        DateTime?
  deletedAt     DateTime? // set when sender deletes; text cleared to '[deleted]'
  createdAt     DateTime  @default(now())
  chat          Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, senderUid, clientMsgId])
  @@index([chatId, createdAt])
  @@index([chatId, senderUid])
  @@index([senderUid])
}

model MeltSession {
  id        String   @id @default(cuid())
  hostUid   String
  targetUid String
  slotLabel String?
  status    String   @default("pending")
  expiresAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([hostUid])
  @@index([targetUid])
}

model PathsPresence {
  uid          String   @id
  lat          Float
  lng          Float
  geohash      String
  intents      String[]
  radiusKm     Float
  visibleUntil DateTime
  lastActiveAt DateTime @updatedAt

  @@index([geohash, visibleUntil])
}

model PathInvite {
  id          String    @id @default(cuid())
  senderUid   String
  receiverUid String
  intent      String
  status      String    @default("pending")
  expiresAt   DateTime  @default(now())  // auto-set to createdAt + 24h; cleaned up by cron
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([receiverUid, status])
  @@index([senderUid])
  @@index([expiresAt]) // for cron cleanup query
}

model BlindsQueue {
  uid            String   @id
  intent         String
  distanceBucket String
  interests      String[]
  availableUntil DateTime
  createdAt      DateTime @default(now())

  @@index([intent, distanceBucket])
  @@index([availableUntil])
}

model BlindsSession {
  id           String   @id @default(cuid())
  userA        String
  userB        String
  phase        String   @default("active")
  expiresAt    DateTime
  revealA      Boolean  @default(false)
  revealB      Boolean  @default(false)
  reported     Boolean  @default(false)
  reportReason String?

  @@index([userA])
  @@index([userB])
}

model Membership {
  id                    String    @id @default(cuid())
  userId                String    @unique
  platform              String
  productId             String
  active                Boolean   @default(true)
  expiry                DateTime?
  environment           String
  originalTransactionId String?   @unique
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeedPost {
  id         String        @id @default(cuid())
  authorUid  String
  content    String
  photoUrls  String[]
  visibility String        @default("public")
  createdAt  DateTime      @default(now())
  likes      PostLike[]
  comments   PostComment[]

  @@index([authorUid])
  @@index([visibility, createdAt])
}

model PostLike {
  id      String   @id @default(cuid())
  postId  String
  uid     String
  likedAt DateTime @default(now())
  post    FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, uid])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorUid String
  text      String
  createdAt DateTime @default(now())
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model JobLog {
  id        String   @id @default(cuid())
  jobName   String
  payload   Json
  status    String   @default("pending")
  attempts  Int      @default(0)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobName, status])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
}

// Access token blacklist — populated on logout so stolen tokens can't be reused
model TokenBlacklist {
  id        String   @id @default(cuid())
  jti       String   @unique  // JWT ID claim (or token hash for legacy tokens)
  expiresAt DateTime           // copied from JWT exp — enables cron cleanup
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ── Freeze Room ──────────────────────────────────────────────────────────────

model FreezeRoom {
  id          String              @id @default(cuid())
  openedAt    DateTime            @default(now())
  closesAt    DateTime            // openedAt + 20 minutes
  promptType  String              // reflective | playful | values
  prompt      String
  status      String              @default("open") // open | closed
  participants FreezeRoomParticipant[]

  @@index([status, closesAt])
}

model FreezeRoomParticipant {
  id        String    @id @default(cuid())
  roomId    String
  uid       String
  answer    String?
  reveals   String[]  // UIDs this participant has revealed to (max 3)
  joinedAt  DateTime  @default(now())
  room      FreezeRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, uid])
  @@index([uid])
}

model FreezeMatch {
  id        String   @id @default(cuid())
  roomId    String
  userA     String
  userB     String
  createdAt DateTime @default(now())

  @@unique([userA, userB])
  @@index([userA])
  @@index([userB])
}

// ── Pool Session (nightly dating pool open/close) ───────────────────────────

model PoolSession {
  id        String   @id @default(cuid())
  opensAt   DateTime
  closesAt  DateTime
  isOpen    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([opensAt])
  @@index([closesAt])
}

// ── Block list ───────────────────────────────────────────────────────────────

model Block {
  id          String   @id @default(cuid())
  blockerUid  String
  blockedUid  String
  createdAt   DateTime @default(now())

  @@unique([blockerUid, blockedUid])
  @@index([blockerUid])
  @@index([blockedUid])
}

model Report {
  id          String   @id @default(cuid())
  reporterUid String
  reportedUid String
  reason      String
  details     String?
  context     String?  // chat | profile | feed | melt
  contextId   String?  // e.g. chatId, postId, sessionId
  status      String   @default("open") // open | reviewed | actioned | dismissed
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?

  @@index([reportedUid])
  @@index([reporterUid])
  @@index([status])
}

// ── Presence events (for computing presenceScore) ────────────────────────────

model PresenceEvent {
  id        String   @id @default(cuid())
  uid       String
  eventType String   // app_open | message_sent | match_responded | room_joined
  createdAt DateTime @default(now())

  @@index([uid, createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  uid       String?
  email     String?
  category  String
  message   String
  platform  String?
  status    String   @default("open")
  createdAt DateTime @default(now())

  @@index([uid])
  @@index([status])
}

