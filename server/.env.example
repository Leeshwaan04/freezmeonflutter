# Server
PORT=3000
NODE_ENV=production

# PostgreSQL
DATABASE_URL="postgresql://freezme:YOUR_PASSWORD@localhost:5432/freezme_db"

# JWT
JWT_SECRET=your-very-long-random-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# Apple OAuth
APPLE_CLIENT_ID=com.freezme.app
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
# Path to Apple private key file (.p8)
APPLE_PRIVATE_KEY_PATH=/etc/freezme/apple_auth_key.p8

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=freezme-user-uploads
S3_PUBLIC_BASE_URL=https://d66jxis80dykc.cloudfront.net

# Firebase Admin SDK (FCM only — push notifications)
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/freezme/firebase-service-account.json

# Google Play IAP
PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
PLAY_BILLING_PACKAGE_NAME=com.freezme.app

# Apple IAP
APPLE_SHARED_SECRET=your-apple-shared-secret

# Email (SMTP via SES or any SMTP provider)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-ses-smtp-user
SMTP_PASS=your-ses-smtp-password
EMAIL_FROM=noreply@freezme.in
APP_BASE_URL=https://freezme.in
