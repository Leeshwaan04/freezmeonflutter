rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core helpers
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Ensures a user cannot make themselves Premium via the client
    function isPremiumUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'credits', 'karma']);
    }

    // Profiles: read any, write only your own, isPremium is read-only for clients
    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) 
        && !request.resource.data.get('isPremium', false); // Can't start as premium
      allow update: if isOwner(uid) && isPremiumUnchanged();
    }

    // Likes/Skips: Immutable history
    match /likes/{docId} {
      allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.senderUid == request.auth.uid || resource.data.targetUid == request.auth.uid);
      allow update, delete: if false;
    }
    match /skips/{docId} {
      allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.senderUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Matches: Participant-only read, System-only write
    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow write: if false; 
    }

    // Chats and messages
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if false; // Created by server logic (Likes/Blinds)
      allow update: if isSignedIn() && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /messages/{msgId} {
        allow create: if isSignedIn()
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow update, delete: if false;
      }
    }

    // Paths
    match /paths_presence/{uid} {
      allow write: if isOwner(uid);
      allow read: if isSignedIn();
    }

    match /path_invites/{inviteId} {
      allow create: if isSignedIn() && request.resource.data.sender_uid == request.auth.uid;
      allow read, update: if isSignedIn() &&
        (resource.data.sender_uid == request.auth.uid ||
         resource.data.receiver_uid == request.auth.uid);
      allow delete: if false;
    }

    // Blinds
    match /blinds_queue/{uid} {
      allow write: if isOwner(uid);
      allow read: if false;
    }

    match /blinds_sessions/{sessionId} {
      allow read, update: if isSignedIn() &&
        (resource.data.user_a == request.auth.uid ||
         resource.data.user_b == request.auth.uid);
      allow create, delete: if false;
    }

    // Feed
    match /feed_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.authorUid);
      allow update, delete: if isOwner(resource.data.authorUid);
    }

    match /post_likes/{postId}/likes/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    match /post_comments/{postId}/comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.authorUid);
      allow delete: if isOwner(resource.data.authorUid);
    }

    // Private User Data
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

