rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Profiles: users can read any, write only their own document.
    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Likes/Skips: direct collections (not nested)
    match /likes/{docId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if false;
    }
    match /skips/{docId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // Matches: readable to participants.
    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow write: if false; // created via functions
    }

    // Presence (online/offline)
    match /presence/{uid} {
      allow write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isSignedIn();
    }

    // Chats and messages (uses 'members' not 'participants')
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
      allow update: if isSignedIn() && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /messages/{msgId} {
        allow create: if isSignedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow read: if isSignedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow update, delete: if false;
      }
    }

    // Paths presence and invites
    match /paths_presence/{uid} {
      allow write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isSignedIn();
    }

    match /path_invites/{inviteId} {
      allow create: if isSignedIn() && request.resource.data.sender_uid == request.auth.uid;
      allow read, update: if isSignedIn() &&
        (resource.data.sender_uid == request.auth.uid ||
         resource.data.receiver_uid == request.auth.uid);
      allow delete: if false;
    }

    // Blinds queue: only user can write their own queue doc
    match /blinds_queue/{uid} {
      allow write: if isSignedIn() && request.auth.uid == uid;
      allow read: if false;
    }

    // Blinds sessions: participants can read/update
    match /blinds_sessions/{sessionId} {
      allow read, update: if isSignedIn() &&
        (resource.data.user_a == request.auth.uid ||
         resource.data.user_b == request.auth.uid);
      allow create, delete: if false;
    }

    // Feed Posts
    match /feed_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    // Post Likes
    match /post_likes/{postId}/likes/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Post Comments
    match /post_comments/{postId}/comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }


    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
