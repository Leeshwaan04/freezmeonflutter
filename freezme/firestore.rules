rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Profiles collection
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Chats Collection (Chat functionality)
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow write: if isSignedIn() && request.auth.uid in resource.data.members; // For updating last message etc?
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
      }
    }

    // Legacy Conversations support (if any)
    match /conversations/{chatId} {
        allow read, write: if false; 
    }

    // Blinds Sessions
    match /blinds_sessions/{sessionId} {
      // Read allowed for participants
      allow read: if isSignedIn() && (resource.data.user_a == request.auth.uid || resource.data.user_b == request.auth.uid);
      // Writes usually via Cloud Functions, but allowing reveal vote if needed directly?
      // respondBlindReveal is Cloud Function, so simple read is enough for frontend listener.
      allow write: if false; 
    }

    // Melt Invites
    match /melt_invites/{inviteId} {
      allow read: if isSignedIn() && (resource.data.senderUid == request.auth.uid || resource.data.targetUid == request.auth.uid);
      allow write: if false; // Handled by Cloud Functions
    }

    // Paths Presence
    match /paths_presence/{docId} {
      allow read: if isSignedIn();
      // Doc ID IS the uid
      allow write: if isOwner(docId);
    }

    // Path Invites
    match /path_invites/{inviteId} {
      allow read: if isSignedIn() && (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
      allow write: if false; // Handled by Cloud Functions
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
